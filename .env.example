# Copie para .env e preencha. Sem MP_ACCESS_TOKEN o site roda em modo simulado.

# Senha da area da equipe (painel, check-in, caixa, bar e cozinha)
ADMIN_PASSWORD=troque-esta-senha

# Endereco publico do site, sem barra no final (usado no retorno do cartao e no webhook)
PUBLIC_URL=http://localhost:8000

# Mercado Pago: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integracoes > Webhooks)
MP_WEBHOOK_SECRET=

# Minutos para o pagamento expirar e o ingresso voltar ao estoque
PAYMENT_EXPIRATION_MINUTES=30

# Caminho do banco SQLite (opcional)
# DATABASE_PATH=/var/data/festa.db
